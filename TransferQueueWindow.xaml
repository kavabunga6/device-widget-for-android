<Window x:Class="AndroidWidget.TransferQueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:AndroidWidget.Presentation.Chrome"
        Title="Передачи Device Widget" Icon="{StaticResource AppIconImage}"
        Width="520" Height="430" MinWidth="430" MinHeight="320"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DialogWindowStyle}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <chrome:DialogTitleBar Title="Передачи" Subtitle="Device Widget" />
        <Grid Grid.Row="1" Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Передачи" FontSize="23" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Файлы и APK обрабатываются по очереди; активную операцию можно отменить"
                       Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <TextBlock x:Name="EmptyText" Text="Очередь пока пуста" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="JobsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,9" Padding="13" CornerRadius="12"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Height="5" Margin="0,9,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding ProgressPercent}"
                                                     IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{DynamicResource Accent}"
                                                     Background="{DynamicResource MutedSurfaceBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Отмена" Margin="12,0,0,0"
                                            Style="{StaticResource DialogButton}"
                                            VerticalAlignment="Center" IsEnabled="{Binding CanCancel}"
                                            Click="CancelButton_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="2" Content="Закрыть" Width="96" Style="{StaticResource DialogButton}"
                HorizontalAlignment="Right" IsDefault="True" Click="CloseButton_Click" />
        </Grid>
    </Grid>
</Window>

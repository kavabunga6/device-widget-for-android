<Window x:Class="AndroidWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Android Widget" Width="440" Height="388"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="13,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="13"
                                Background="{DynamicResource MutedSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3"
                                     HorizontalAlignment="Left" Fill="{DynamicResource TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{DynamicResource WindowSurface}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="15,0,10,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="15" Height="22" CornerRadius="4" Margin="1,0,9,0"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                        VerticalAlignment="Center">
                    <Border Width="7" Height="11" CornerRadius="2" Background="{DynamicResource Accent}" />
                </Border>
                <TextBlock Grid.Column="1" Text="Настройки Android Widget" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="×" Width="30" Height="30" Padding="0" Margin="0"
                        FontSize="17" Style="{StaticResource ActionButton}"
                        HorizontalContentAlignment="Center" Click="CloseButton_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="27,17,27,23">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Внешний вид и поведение виджета"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Тема" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Применяется сразу" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="3" CornerRadius="11"
                            Background="{DynamicResource MutedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="DarkThemeRadio" Content="Тёмная" GroupName="Theme"
                                         Style="{StaticResource ThemeChoiceStyle}"
                                         Checked="ThemeRadio_Checked" />
                            <RadioButton x:Name="LightThemeRadio" Grid.Column="1" Content="Светлая" GroupName="Theme"
                                         Style="{StaticResource ThemeChoiceStyle}"
                                         Checked="ThemeRadio_Checked" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,18,0,0" Padding="14" CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Без телефона останется только значок в трее"
                                       FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource SwitchStyle}" Click="AutoStartToggle_Click" />
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,2,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" />

                <Button Grid.Row="4" Content="Готово" Width="104" Height="38" HorizontalAlignment="Right"
                        Style="{StaticResource ActionButton}" Margin="0" Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>

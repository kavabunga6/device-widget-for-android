<Window x:Class="AndroidWidget.Desktop.MediaSettingsWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медиа и scrcpy" Icon="/Assets/AppIcon.png" Width="540" Height="570"
        MinWidth="480" MinHeight="550" WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None">
  <Window.Styles>
    <Style Selector="Border.card"><Setter Property="Padding" Value="16"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.action"><Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource MutedSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Styles>
  <Border CornerRadius="18" Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" BoxShadow="0 12 32 0 #77000000">
    <Grid RowDefinitions="44,*">
      <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto" PointerPressed="TitleBar_PointerPressed">
        <Border Width="22" Height="28" CornerRadius="7" BorderBrush="#8A73FF" BorderThickness="1.4" VerticalAlignment="Center"><TextBlock Text="▯" Foreground="#8A73FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="8,7,0,0"><TextBlock Text="Медиа и scrcpy" FontSize="11" Foreground="{DynamicResource Primary}"/><TextBlock Text="Device Widget" FontSize="9" Foreground="{DynamicResource Secondary}"/></StackPanel>
        <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="17"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="{DynamicResource MutedSurface}" Click="CloseButton_Click">
          <Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="22,14,22,22" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel><TextBlock Text="Медиа и scrcpy" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Запись экрана, качество трансляции и импорт фотографий" Margin="0,4,0,0" Foreground="{DynamicResource Secondary}"/></StackPanel>
        <Border Grid.Row="1" Classes="card" Margin="0,18,0,0">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,190">
            <StackPanel><TextBlock Text="Пресет scrcpy" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Применяется к трансляции и записи" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"/></StackPanel>
            <ComboBox x:Name="PresetCombo" Grid.Column="1" SelectionChanged="PresetCombo_SelectionChanged"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,0" Text="Папка записей" FontSize="10" Foreground="{DynamicResource Secondary}"/>
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,30,0,0" ColumnDefinitions="*,Auto"><TextBox x:Name="RecordingFolderText" Height="36" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Column="1" Classes="action" Content="Выбрать" Width="86" Margin="8,0,0,0" Click="RecordingFolderButton_Click"/></Grid>
          </Grid>
        </Border>
        <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
          <StackPanel><TextBlock Text="Новые фотографии" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><CheckBox x:Name="NotifyPhotosCheck" Margin="0,12,0,0" Content="Уведомлять о новых фото" Click="PhotoOption_Click"/><CheckBox x:Name="AutoImportCheck" Margin="0,8,0,0" Content="Автоматически импортировать новые фото из DCIM/Camera" Click="PhotoOption_Click"/><Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto"><TextBox x:Name="PhotoFolderText" Height="36" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Column="1" Classes="action" Content="Папка импорта" Width="132" Margin="8,0,0,0" Click="PhotoFolderButton_Click"/></Grid><TextBlock Margin="0,9,0,0" FontSize="10" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Text="При первом сканировании существующие снимки становятся базовой линией и не импортируются повторно."/></StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,2,0" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"/>
        <Button Grid.Row="4" Classes="action" Content="Готово" Width="100"
                Margin="0,16,0,0" HorizontalAlignment="Right" Click="CloseButton_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>

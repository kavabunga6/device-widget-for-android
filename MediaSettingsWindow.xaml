<Window x:Class="AndroidWidget.MediaSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медиа и scrcpy" Icon="{StaticResource AppIconImage}"
        Width="540" Height="520" MinWidth="480" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Медиа и scrcpy" FontSize="23" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Запись экрана, качество трансляции и импорт фотографий"
                       Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Padding="15" CornerRadius="13"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Пресет scrcpy" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Применяется к трансляции и записи" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <ComboBox x:Name="PresetCombo" Grid.Column="1" Padding="8" SelectionChanged="PresetCombo_SelectionChanged" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,4" Text="Папка записей"
                           FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="RecordingFolderText" IsReadOnly="True" Padding="9" />
                    <Button Grid.Column="1" Content="Выбрать" Margin="8,0,0,0" Padding="12,7"
                            Click="RecordingFolderButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="15" CornerRadius="13"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Новые фотографии" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <CheckBox x:Name="NotifyPhotosCheck" Margin="0,12,0,0" Content="Уведомлять о новых фото"
                          Click="PhotoOption_Click" />
                <CheckBox x:Name="AutoImportCheck" Margin="0,8,0,0"
                          Content="Автоматически импортировать новые фото из DCIM/Camera"
                          Click="PhotoOption_Click" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="PhotoFolderText" IsReadOnly="True" Padding="9" />
                    <Button Grid.Column="1" Content="Папка импорта" Margin="8,0,0,0" Padding="12,7"
                            Click="PhotoFolderButton_Click" />
                </Grid>
                <TextBlock Margin="0,9,0,0" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="При первом сканировании существующие снимки становятся базовой линией и не импортируются повторно." />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,2,0" FontSize="10.5"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        <Button Grid.Row="4" Content="Готово" Width="100" Padding="13,8" HorizontalAlignment="Right"
                IsDefault="True" Click="CloseButton_Click" />
    </Grid>
</Window>

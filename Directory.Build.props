<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.10</Version>
    <Authors>Device Widget contributors</Authors>
    <Company>Device Widget contributors</Company>
    <Product>Device Widget for Android</Product>
    <Description>Local desktop companion for Android devices connected through ADB.</Description>
    <Copyright>Copyright © 2026 Device Widget contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>

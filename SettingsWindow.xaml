<Window x:Class="AndroidWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:AndroidWidget.Presentation.Chrome"
        Title="Настройки Device Widget" Width="440" Height="650"
        Icon="{StaticResource AppIconImage}"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="ThemeChoiceStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="13,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background"
                                        Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="13"
                                Background="{DynamicResource MutedSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3"
                                     HorizontalAlignment="Left" Fill="{DynamicResource TextSecondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{DynamicResource WindowSurface}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="43" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <chrome:DialogTitleBar Title="Настройки" Subtitle="Device Widget" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <Grid Margin="27,17,19,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Внешний вид и поведение виджета"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Тема" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Применяется сразу" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="3" CornerRadius="11"
                            Background="{DynamicResource MutedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="DarkThemeRadio" Content="Тёмная" GroupName="Theme"
                                         Style="{StaticResource ThemeChoiceStyle}"
                                         Checked="ThemeRadio_Checked" />
                            <RadioButton x:Name="LightThemeRadio" Grid.Column="1" Content="Светлая" GroupName="Theme"
                                         Style="{StaticResource ThemeChoiceStyle}"
                                         Checked="ThemeRadio_Checked" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,18,0,0" Padding="14" CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Без телефона останется только значок в трее"
                                       FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource SwitchStyle}" Click="AutoStartToggle_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="0,12,0,0" Padding="14" CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Показывать уведомления у карточки" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Компаньон передаёт разрешённые Android-уведомления только локально"
                                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,12,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton x:Name="SmsBubblesToggle" Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource SwitchStyle}" Click="SmsBubblesToggle_Click" />

                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Время показа" Margin="0,0,14,0" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                            <Border Grid.Column="1" Padding="3" CornerRadius="9"
                                    Background="{DynamicResource MutedSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <UniformGrid Columns="5">
                                    <RadioButton x:Name="Duration5Radio" Content="5 с" GroupName="Duration"
                                                 Style="{StaticResource ThemeChoiceStyle}"
                                                 Checked="NotificationDuration_Checked" />
                                    <RadioButton x:Name="Duration10Radio" Content="10 с" GroupName="Duration"
                                                 Style="{StaticResource ThemeChoiceStyle}"
                                                 Checked="NotificationDuration_Checked" />
                                    <RadioButton x:Name="Duration15Radio" Content="15 с" GroupName="Duration"
                                                 Style="{StaticResource ThemeChoiceStyle}"
                                                 Checked="NotificationDuration_Checked" />
                                    <RadioButton x:Name="Duration30Radio" Content="30 с" GroupName="Duration"
                                                 Style="{StaticResource ThemeChoiceStyle}"
                                                 Checked="NotificationDuration_Checked" />
                                    <RadioButton x:Name="Duration60Radio" Content="60 с" GroupName="Duration"
                                                 Style="{StaticResource ThemeChoiceStyle}"
                                                 Checked="NotificationDuration_Checked" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Margin="0,12,0,0" Padding="14" CornerRadius="13"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Папка для скриншотов" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Снимки сохраняются автоматически с именем телефона и датой"
                                       FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="10,8" CornerRadius="9"
                                    Background="{DynamicResource MutedSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="ScreenshotFolderText" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </Border>
                            <Button Grid.Column="1" Content="Выбрать" Width="86" Height="34"
                                    Margin="8,0,0,0" Padding="0" Style="{StaticResource ActionButton}"
                                    HorizontalContentAlignment="Center" Click="ScreenshotFolderButton_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" Margin="0,12,0,0">
                    <Button Content="Медиа, запись и импорт фото…" Height="36" Padding="12,0"
                            Style="{StaticResource ActionButton}" HorizontalContentAlignment="Center"
                            Click="MediaSettingsButton_Click" />
                    <Button Content="Лицензии и сторонние компоненты…" Height="36" Padding="12,0"
                            Margin="0,8,0,0" Style="{StaticResource ActionButton}"
                            HorizontalContentAlignment="Center" Click="LicensesButton_Click" />
                    <TextBlock x:Name="StatusText" Margin="2,8,2,0"
                               Foreground="{DynamicResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" />
                </StackPanel>

            </Grid>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Готово" Width="104" Height="38"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource ActionButton}" Margin="0,6,27,0" Padding="0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>

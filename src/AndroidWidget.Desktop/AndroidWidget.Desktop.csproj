<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AndroidWidget.Desktop</RootNamespace>
    <AssemblyName>DeviceWidget</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="..\..\vendor\scrcpy-win64-v4.0.zip"
                      LogicalName="AndroidWidget.Desktop.Bundled.scrcpy-win64-v4.0.zip" />
    <EmbeddedResource Include="..\..\vendor\scrcpy-LICENSE.txt"
                      LogicalName="AndroidWidget.Desktop.Bundled.scrcpy-LICENSE.txt" />
    <EmbeddedResource Include="..\..\companion-android\app\build\outputs\apk\release\app-release.apk"
                      Condition="Exists('..\..\companion-android\app\build\outputs\apk\release\app-release.apk')"
                      LogicalName="AndroidWidget.Desktop.Bundled.DeviceWidget-Companion.apk" />
    <EmbeddedResource Include="..\..\companion-android\app\build\outputs\apk\debug\app-debug.apk"
                      Condition="!Exists('..\..\companion-android\app\build\outputs\apk\release\app-release.apk') And Exists('..\..\companion-android\app\build\outputs\apk\debug\app-debug.apk')"
                      LogicalName="AndroidWidget.Desktop.Bundled.DeviceWidget-Companion.apk" />
    <EmbeddedResource Include="..\..\companion-android\version.properties"
                      LogicalName="AndroidWidget.Desktop.Bundled.companion-version.properties" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidWidget.Core\AndroidWidget.Core.csproj" />
    <ProjectReference Include="..\AndroidWidget.CompanionHost\AndroidWidget.CompanionHost.csproj" />
    <ProjectReference Include="..\AndroidWidget.Protocol\AndroidWidget.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="AndroidWidget.Desktop.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD_PARTY_NOTICES.md" LogicalName="AndroidWidget.Desktop.THIRD_PARTY_NOTICES.md" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\SOURCE_OFFER.md" Link="SOURCE_OFFER.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

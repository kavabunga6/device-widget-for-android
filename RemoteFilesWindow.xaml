<Window x:Class="AndroidWidget.RemoteFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файлы Android" Width="700" Height="530" MinWidth="560" MinHeight="390"
        Icon="{StaticResource AppIconImage}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowSurface}"
        Foreground="{DynamicResource TextPrimary}" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#282448" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Файлы и фотографии" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceText" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Камера" Click="CameraButton_Click" />
                <Button Content="Загрузки" Click="DownloadsButton_Click" />
                <Button Content="Обновить" Margin="0" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,17,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="↑" Width="38" Padding="0" ToolTip="На уровень выше" Click="UpButton_Click" />
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,8">
                <TextBlock x:Name="PathText" Text="/sdcard" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13">
            <Grid>
                <ListBox x:Name="FilesList" Background="Transparent" BorderThickness="0" Margin="7"
                         MouseDoubleClick="FilesList_MouseDoubleClick" SelectionChanged="FilesList_SelectionChanged"
                         PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="FilesList_PreviewMouseMove">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Foreground="#927CFF" FontSize="17"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="Открыть  ›" Foreground="{DynamicResource TextSecondary}" FontSize="10"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Папка пуста" FontSize="18" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" />
                    <TextBlock Text="или Android не дал доступ к содержимому" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,13,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="{DynamicResource TextSecondary}" FontSize="10"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="Открыть" IsEnabled="False" Click="OpenButton_Click" />
                <Button x:Name="DownloadButton" Content="Скачать на ПК" IsEnabled="False" Margin="0"
                        Click="DownloadButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

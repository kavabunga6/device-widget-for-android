<Window x:Class="AndroidWidget.Desktop.WirelessAdbWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi-Fi ADB" Icon="/Assets/AppIcon.png"
        Width="540" Height="560" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource MutedSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.endpoint">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Background" Value="{DynamicResource InputSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="18" Background="{DynamicResource WindowSurface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Grid RowDefinitions="44,*">
      <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto" PointerPressed="TitleBar_PointerPressed">
        <Border Width="22" Height="28" CornerRadius="7" BorderBrush="#326BB5"
                BorderThickness="1.4" VerticalAlignment="Center">
          <TextBlock Text="⌁" Foreground="#4A83D1" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,7,0,0">
          <TextBlock Text="Wi-Fi ADB" FontSize="11" Foreground="{DynamicResource Primary}" />
          <TextBlock x:Name="VersionText" FontSize="9" Foreground="{DynamicResource Secondary}" />
        </StackPanel>
        <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="17"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="{DynamicResource MutedSurface}" Click="CloseButton_Click">
          <Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round" /></Canvas></Viewbox>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="22,14,22,22" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock Text="Беспроводная отладка" FontSize="23" FontWeight="SemiBold"
                     Foreground="{DynamicResource Primary}" />
          <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"
                     Text="На телефоне откройте Для разработчиков → Беспроводная отладка → Сопряжение с помощью кода." />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Margin="0,18,0,0">
          <StackPanel>
            <TextBlock Text="1 · Сопряжение" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"
                       Text="Введите адрес сопряжения и шестизначный код с телефона." />
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,112,Auto">
              <TextBox x:Name="PairEndpointText" Classes="endpoint" PlaceholderText="192.168.1.20:37123" />
              <TextBox x:Name="PairCodeText" Grid.Column="1" Classes="endpoint" Margin="8,0,0,0"
                       PlaceholderText="6 цифр" MaxLength="6" />
              <Button x:Name="PairButton" Grid.Column="2" Classes="action" Margin="8,0,0,0"
                      Content="Сопрячь" Click="PairButton_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="2 · Подключение" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
            <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"
                       TextWrapping="Wrap"
                       Text="Вернитесь на основной экран беспроводной отладки: порт подключения обычно отличается от порта сопряжения." />
            <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
              <TextBox x:Name="ConnectEndpointText" Classes="endpoint" PlaceholderText="192.168.1.20:39555" />
              <Button x:Name="ConnectButton" Grid.Column="1" Classes="action" Margin="8,0,0,0"
                      Content="Подключить" Click="ConnectButton_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,14,2,0" FontSize="10.5"
                   Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />

        <Button Grid.Row="4" Classes="action" Content="Готово" Width="104"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseButton_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>

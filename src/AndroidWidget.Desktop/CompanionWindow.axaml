<Window x:Class="AndroidWidget.Desktop.CompanionWindow"
        xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Компаньон Device Widget" Icon="/Assets/AppIcon.png"
        Width="540" Height="590" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource MutedSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Border CornerRadius="18" Background="{DynamicResource WindowSurface}"
          BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Grid RowDefinitions="44,*">
      <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto" PointerPressed="TitleBar_PointerPressed">
        <Border Width="22" Height="28" CornerRadius="7" BorderBrush="#6157A8"
                BorderThickness="1.4" VerticalAlignment="Center">
          <TextBlock Text="◫" Foreground="#8A73FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="8,7,0,0">
          <TextBlock Text="Компаньон" FontSize="11" Foreground="{DynamicResource Primary}" />
          <TextBlock x:Name="VersionText" FontSize="9" Foreground="{DynamicResource Secondary}" />
        </StackPanel>
        <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="17"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="{DynamicResource MutedSurface}" Click="CloseButton_Click">
          <Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round" /></Canvas></Viewbox>
        </Button>
      </Grid>

      <Grid Grid.Row="1" Margin="22,14,22,22" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel>
          <TextBlock Text="Компаньон на телефоне" FontSize="23" FontWeight="SemiBold"
                     Foreground="{DynamicResource Primary}" />
          <TextBlock x:Name="DeviceNameText" Margin="0,4,0,0"
                     Foreground="{DynamicResource Secondary}" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Margin="0,18,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="48" Height="48" CornerRadius="14" Background="#6157A8">
              <TextBlock Text="◫" FontSize="24" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,2,10,0">
              <TextBlock Text="Приложение-компаньон" FontWeight="SemiBold"
                         Foreground="{DynamicResource Primary}" />
              <TextBlock x:Name="CompanionStateText" Text="Проверяю состояние…" Margin="0,5,0,0"
                         FontSize="10.5" Foreground="{DynamicResource Secondary}" />
            </StackPanel>
            <Button x:Name="CompanionActionButton" Grid.Column="2" Classes="action"
                    Content="Проверяю…" MinWidth="126" Click="CompanionActionButton_Click" />
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Сопряжение" FontWeight="SemiBold"
                           Foreground="{DynamicResource Primary}" />
                <TextBlock Text="Одноразовый код действует пять минут" Margin="0,5,0,0"
                           FontSize="10" Foreground="{DynamicResource Secondary}" />
              </StackPanel>
              <Button x:Name="NewCodeButton" Grid.Column="1" Classes="action"
                      Content="Новый код" Width="106" Click="NewCodeButton_Click" />
            </Grid>

            <TextBlock x:Name="PairCodeText" Text="—— ——" Margin="0,14,0,0" FontSize="30"
                       FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <TextBox x:Name="PairingUriText" Margin="0,10,0,0" Height="54" Padding="10,6"
                     IsReadOnly="True" TextWrapping="Wrap"
                     PlaceholderText="Одноразовая ссылка появится после генерации кода" />
            <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="PairingHintText" Text="Сначала установите или откройте компаньон"
                         FontSize="10" Foreground="{DynamicResource Secondary}"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button x:Name="CopyPairingButton" Grid.Column="1" Classes="action"
                      Content="Копировать" Width="106" IsEnabled="False"
                      Click="CopyPairingButton_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="2,12,2,0">
          <TextBlock x:Name="HostStatusText" FontSize="10" Foreground="#72D8A2" />
          <TextBlock x:Name="StatusText" Margin="0,7,0,0" FontSize="10.5"
                     Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
        </StackPanel>

        <Button Grid.Row="4" Classes="action" Content="Готово" Width="104"
                HorizontalAlignment="Right" Margin="0,14,0,0" Click="CloseButton_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>

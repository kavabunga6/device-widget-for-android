<Window x:Class="AndroidWidget.Desktop.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Device Widget" Icon="/Assets/AppIcon.png"
        Width="440" Height="650" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="36"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource MutedSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>
  <Border CornerRadius="18" Background="{DynamicResource WindowSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Grid RowDefinitions="43,*,60">
      <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto" PointerPressed="TitleBar_PointerPressed">
        <Border Width="22" Height="28" CornerRadius="7" BorderBrush="#8A73FF" BorderThickness="1.4"
                VerticalAlignment="Center"><TextBlock Text="▯" Foreground="#8A73FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel Grid.Column="1" Margin="8,7,0,0">
          <TextBlock Text="Настройки" FontSize="11" Foreground="{DynamicResource Primary}"/>
          <TextBlock x:Name="VersionText" FontSize="9" Foreground="{DynamicResource Secondary}"/>
        </StackPanel>
        <Button Grid.Column="2" Width="34" Height="34" Padding="0" CornerRadius="17"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Background="{DynamicResource MutedSurface}" Click="CloseButton_Click">
          <Viewbox Width="12" Height="12"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="27,17,27,10">
          <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/>
          <TextBlock Text="Внешний вид и поведение виджета" Margin="0,4,0,0" Foreground="{DynamicResource Secondary}"/>

          <Grid Margin="0,20,0,0" ColumnDefinitions="*,210">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Тема" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Применяется сразу" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"/></StackPanel>
            <Border Grid.Column="1" Padding="12,7" CornerRadius="11"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,*">
                <TextBlock Text="Тёмная" Foreground="{DynamicResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <ToggleSwitch x:Name="ThemeToggle" Grid.Column="1" Margin="10,0" OnContent="" OffContent=""
                              IsCheckedChanged="ThemeToggle_Changed"/>
                <TextBlock Grid.Column="2" Text="Светлая" Foreground="{DynamicResource Primary}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </Grid>

          <Border Classes="card" Margin="0,18,0,0"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Запускать вместе с системой" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Показывать виджет после входа в систему" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"/></StackPanel><ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" IsCheckedChanged="SettingToggle_Changed"/></Grid></Border>
          <Border Classes="card" Margin="0,12,0,0">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Показывать уведомления у карточки" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Companion передаёт уведомления только локально" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"/></StackPanel><ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" OnContent="" OffContent="" IsCheckedChanged="SettingToggle_Changed"/></Grid>
              <Grid Margin="0,13,0,0" ColumnDefinitions="Auto,*"><TextBlock Text="Время показа" Margin="0,0,14,0" FontSize="10.5" Foreground="{DynamicResource Secondary}" VerticalAlignment="Center"/><ComboBox x:Name="DurationCombo" Grid.Column="1" SelectionChanged="DurationCombo_SelectionChanged"/></Grid>
            </StackPanel>
          </Border>
          <Border Classes="card" Margin="0,12,0,0">
            <StackPanel><TextBlock Text="Папка для скриншотов" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"/><TextBlock Text="Снимки сохраняются автоматически с датой" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Secondary}"/><Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto"><TextBox x:Name="ScreenshotFolderText" Height="36" Padding="10,0" VerticalContentAlignment="Center" IsReadOnly="True"/><Button Grid.Column="1" Classes="action" Content="Выбрать" Width="86" Margin="8,0,0,0" Click="ScreenshotFolderButton_Click"/></Grid></StackPanel>
          </Border>
          <Button Classes="action" Content="Медиа, запись и импорт фото…" Width="386" Margin="0,12,0,0" HorizontalAlignment="Center" Click="MediaSettingsButton_Click"/>
          <Button Classes="action" Content="Лицензии и сторонние компоненты…" Width="386" Margin="0,8,0,0" HorizontalAlignment="Center" Click="LicensesButton_Click"/>
          <TextBlock x:Name="StatusText" Margin="2,8,2,0" FontSize="10.5" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <Button Grid.Row="2" Classes="action" Content="Готово" Width="104" HorizontalAlignment="Right" Margin="0,6,27,16" Click="CloseButton_Click"/>
    </Grid>
  </Border>
</Window>

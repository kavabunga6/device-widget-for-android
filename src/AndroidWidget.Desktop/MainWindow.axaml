<Window x:Class="AndroidWidget.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Widget for Android" Icon="/Assets/AppIcon.png"
        Width="258" Height="392" MinWidth="258" MinHeight="392"
        Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="None"
        CanResize="True" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Height" Value="82" />
      <Setter Property="Width" Value="88" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Primary}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBox.compact">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
  </Window.Styles>

  <Grid>
  <Viewbox Stretch="Uniform" StretchDirection="Both">
  <Grid x:Name="RootLayout" Margin="4">
    <Border x:Name="PhoneShell" Width="242" Height="376" VerticalAlignment="Top" CornerRadius="38" Margin="4"
            Background="{DynamicResource Shell}" BorderBrush="{DynamicResource Border}" BorderThickness="1.2"
            DragDrop.AllowDrop="True" DragDrop.DragOver="PhoneShell_DragOver" DragDrop.Drop="PhoneShell_Drop"
            PointerPressed="PhoneShell_PointerPressed">
      <Grid Margin="9">
        <Border CornerRadius="30" Background="{DynamicResource Screen}"
                BorderBrush="#343945" BorderThickness="1">
          <Grid>
            <Grid x:Name="FullPhoneContent" RowDefinitions="35,*,49">
              <Grid Grid.Row="0" Margin="13,0,9,0" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                    Background="Transparent" PointerPressed="DragHandle_PointerPressed">
                <TextBlock Text="ADB" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource Secondary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chrome" Content="−" FontSize="22"
                        ToolTip.Tip="Мини-виджет" Click="MiniModeButton_Click" />
                <Button Grid.Column="2" Classes="chrome" ToolTip.Tip="Настройки" Click="SettingsButton_Click">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="20" Height="20">
                      <Path Data="M 8,1.5 L 12,1.5 L 12.6,3.6 L 14.1,4.2 L 16,3.1 L 17.9,5 L 16.8,6.9 L 17.4,8.4 L 19.5,9 L 19.5,11 L 17.4,11.6 L 16.8,13.1 L 17.9,15 L 16,16.9 L 14.1,15.8 L 12.6,16.4 L 12,18.5 L 8,18.5 L 7.4,16.4 L 5.9,15.8 L 4,16.9 L 2.1,15 L 3.2,13.1 L 2.6,11.6 L 0.5,11 L 0.5,9 L 2.6,8.4 L 3.2,6.9 L 2.1,5 L 4,3.1 L 5.9,4.2 L 7.4,3.6 Z"
                            Fill="Transparent" Stroke="{DynamicResource Secondary}" StrokeThickness="1.5"
                            StrokeJoin="Round" />
                      <Ellipse Canvas.Left="7" Canvas.Top="7" Width="6" Height="6"
                               Fill="Transparent" Stroke="{DynamicResource Secondary}" StrokeThickness="1.5" />
                    </Canvas>
                  </Viewbox>
                </Button>
                <Button x:Name="PinButton" Grid.Column="3" Classes="chrome" Content="●" FontSize="17"
                        Foreground="{DynamicResource Accent}" ToolTip.Tip="Поверх остальных окон"
                        Click="PinButton_Click" />
                <Button Grid.Column="4" Classes="chrome" ToolTip.Tip="Закрыть" Click="CloseButton_Click">
                  <Viewbox Width="11" Height="11"><Canvas Width="12" Height="12"><Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stroke="{DynamicResource Secondary}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
                </Button>
              </Grid>

              <StackPanel Grid.Row="1" Margin="17,0" VerticalAlignment="Center"
                          Background="Transparent" PointerPressed="PhoneScreen_PointerPressed">
                <Border x:Name="DeviceIconBorder" Width="62" Height="62" CornerRadius="21" HorizontalAlignment="Center"
                        Background="#302B50" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                  <Grid>
                    <Ellipse Width="31" Height="23" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <Ellipse Width="3" Height="3" Fill="White" Margin="-10,-2,0,0" />
                    <Ellipse Width="3" Height="3" Fill="White" Margin="10,-2,0,0" />
                    <Border Width="2" Height="8" CornerRadius="1" Background="{DynamicResource Accent}"
                            Margin="-18,-31,0,0" RenderTransformOrigin="0.5,1">
                      <Border.RenderTransform><RotateTransform Angle="-30" /></Border.RenderTransform>
                    </Border>
                    <Border Width="2" Height="8" CornerRadius="1" Background="{DynamicResource Accent}"
                            Margin="18,-31,0,0" RenderTransformOrigin="0.5,1">
                      <Border.RenderTransform><RotateTransform Angle="30" /></Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="StateOverlayText" IsVisible="False" FontSize="27"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <TextBlock x:Name="DeviceNameText" Text="Ищу устройство…" Margin="0,12,0,2"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Primary}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="36" />
                <TextBlock x:Name="ConnectionText" Text="ADB"
                           FontSize="10.5" Foreground="{DynamicResource Secondary}"
                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30" />
                <Grid x:Name="BatteryPanel" Margin="16,11,16,0">
                  <TextBlock x:Name="BatteryText" Text="—" FontSize="14" FontWeight="SemiBold"
                             Foreground="{DynamicResource Primary}" HorizontalAlignment="Center" />
                </Grid>
                <Button Margin="0,14,0,0" Width="184" Height="34" Padding="8,0" Classes="compact"
                        HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource MutedSurface}" BorderBrush="{DynamicResource Border}"
                        Click="SendFilesButton_Click">
                  <TextBlock x:Name="DropHintText" Text="Перетащите файл или APK" FontSize="9.5"
                             Foreground="{DynamicResource Primary}" />
                </Button>
                <StackPanel Margin="0,8,0,0">
                  <TextBlock x:Name="StatusText" Text="Нажмите, чтобы открыть действия"
                             FontSize="9.5" Foreground="{DynamicResource Secondary}"
                             TextAlignment="Center" TextWrapping="Wrap" MaxHeight="30" />
                </StackPanel>
              </StackPanel>

              <Grid Grid.Row="2">
                <Border Width="72" Height="4" CornerRadius="2" Background="#5D6472"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,11" />
              </Grid>
            </Grid>

            <Grid x:Name="MiniContent" IsVisible="False" Margin="10,13,10,12"
                  RowDefinitions="38,30,*,30" PointerPressed="MiniContent_PointerPressed"
                  PointerMoved="MiniContent_PointerMoved" PointerReleased="MiniContent_PointerReleased">
              <Grid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Развернуть" Click="RestoreFromMiniMenu_Click" />
                  <MenuItem Header="Действия" Click="OpenActionsFromMiniMenu_Click" />
                  <Separator />
                  <MenuItem Header="Настройки" Click="SettingsButton_Click" />
                  <MenuItem Header="Закрыть" Click="CloseButton_Click" />
                </ContextMenu>
              </Grid.ContextMenu>
              <TextBlock x:Name="MiniDeviceNameText" Text="Android" FontSize="11.5" FontWeight="Bold"
                         Foreground="{DynamicResource Primary}" TextAlignment="Center" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" MaxHeight="34" />
              <TextBlock x:Name="MiniConnectionText" Grid.Row="1" Text="USB / ADB" FontSize="9"
                         Foreground="{DynamicResource Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
              <Grid Grid.Row="2">
                <TextBlock x:Name="MiniBatteryText" Text="—" FontSize="22"
                           FontWeight="SemiBold" Foreground="{DynamicResource Primary}"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="MiniStateText" IsVisible="False" FontSize="22"
                           FontWeight="SemiBold" Foreground="{DynamicResource Error}"
                           TextAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="MiniDetailText" Grid.Row="3" Text="Ожидаю устройство" FontSize="9"
                         FontWeight="SemiBold" Foreground="{DynamicResource Secondary}"
                         TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Ellipse x:Name="MiniStatusDot" Grid.RowSpan="4" Width="10" Height="10" Fill="#69738E"
                       Stroke="{DynamicResource Screen}" StrokeThickness="2" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Margin="0,0,-2,-4" />
              <Border Grid.RowSpan="4" Width="20" Height="3" CornerRadius="2" Background="{DynamicResource Accent}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-7" />
            </Grid>

            <Border x:Name="FullLockOverlay" IsVisible="False" Margin="0,35,0,0"
                    CornerRadius="26" Background="#F0181A20" BorderBrush="#FF5C5C"
                    BorderThickness="1.5" ZIndex="20" PointerPressed="PhoneScreen_PointerPressed">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="11">
                <Grid Width="72" Height="72">
                  <Path Data="M 22,34 L 22,25 C 22,14 28,8 36,8 C 44,8 50,14 50,25 L 50,34"
                        Stroke="#FF6969" StrokeThickness="5" StrokeLineCap="Round" Fill="Transparent" />
                  <Border Width="56" Height="40" CornerRadius="10" Background="#382126"
                          BorderBrush="#FF6969" BorderThickness="3" VerticalAlignment="Bottom">
                    <Ellipse Width="7" Height="7" Fill="#FF6969" />
                  </Border>
                </Grid>
                <TextBlock x:Name="FullLockTitle" Text="Телефон заблокирован" FontSize="14"
                           FontWeight="Bold" Foreground="#FF8A8A" TextAlignment="Center" />
                <TextBlock x:Name="FullLockHint" Text="Разблокируйте устройство"
                           FontSize="10" Foreground="#E3A7AC" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <Border x:Name="MiniLockOverlay" IsVisible="False" CornerRadius="29"
                    Background="#F0181A20" BorderBrush="#FF5C5C" BorderThickness="2"
                    ZIndex="20" PointerPressed="MiniContent_PointerPressed"
                    PointerMoved="MiniContent_PointerMoved" PointerReleased="MiniContent_PointerReleased">
              <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <Grid Width="48" Height="52">
                    <Path Data="M 14,25 L 14,18 C 14,10 18,6 24,6 C 30,6 34,10 34,18 L 34,25"
                          Stroke="#FF6969" StrokeThickness="4" StrokeLineCap="Round" Fill="Transparent" />
                    <Border Width="40" Height="29" CornerRadius="8" Background="#382126"
                            BorderBrush="#FF6969" BorderThickness="2.5" VerticalAlignment="Bottom">
                      <Ellipse Width="6" Height="6" Fill="#FF6969" />
                    </Border>
                  </Grid>
                  <TextBlock x:Name="MiniLockTitle" Text="Заблокирован" FontSize="10.5"
                             FontWeight="Bold" Foreground="#FF8A8A" TextAlignment="Center"
                             TextWrapping="Wrap" MaxWidth="88" />
                </StackPanel>
                <Ellipse Width="10" Height="10" Fill="#FF5C5C" Stroke="#181A20" StrokeThickness="2"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" />
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Width="3" Height="34" CornerRadius="2" Background="#687084"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,-45" />
        <Border Width="3" Height="46" CornerRadius="2" Background="#687084"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,-5" />
      </Grid>
    </Border>
    <Border Width="20" Height="20" Background="Transparent"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            PointerPressed="ResizeGrip_PointerPressed">
      <Path Data="M 5,17 L 17,5 M 11,17 L 17,11" Stroke="{DynamicResource Secondary}"
            StrokeThickness="1.4" Opacity="0.65" />
    </Border>
  </Grid>
  </Viewbox>

  <Popup x:Name="ActionDrawerPopup" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
    <Border x:Name="ActionDrawer" Width="318" Height="500"
            VerticalAlignment="Top" Margin="4"
            Padding="14" CornerRadius="24" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Действия" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource Primary}" />
            <TextBlock x:Name="ProductVersionText" Margin="0,3,0,0" FontSize="10"
                       Foreground="{DynamicResource Secondary}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="chrome" Content="‹" FontSize="20"
                  Click="CollapsePanel_Click" ToolTip.Tip="Скрыть действия" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Hidden">
          <StackPanel>
            <UniformGrid Columns="3" Width="282" HorizontalAlignment="Center">
              <Button Classes="tile" Click="ScreenButton_Click" ToolTip.Tip="Трансляция через scrcpy">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#7559E8"><TextBlock Text="▣" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Экран" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button x:Name="RecordButton" Classes="tile" Click="RecordButton_Click" ToolTip.Tip="Начать запись экрана в MKV">
                <StackPanel><Border x:Name="RecordIconBorder" Width="48" Height="48" CornerRadius="14" Background="#C34755"><TextBlock x:Name="RecordIconText" Text="●" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="RecordButtonText" Text="Запись" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="FilesButton_Click" ToolTip.Tip="Открыть файлы телефона">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#E59A27"><TextBlock Text="▰" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Файлы" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="TransfersButton_Click" ToolTip.Tip="Последняя операция передачи">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#287D8E"><TextBlock Text="⇄" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Передачи" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="ScreenshotButton_Click" ToolTip.Tip="Сохранить PNG-скриншот">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#DD4F78"><TextBlock Text="◎" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Скриншот" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="InstallButton_Click" ToolTip.Tip="Установить APK">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#30A66B"><TextBlock Text="↓" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="APK" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="ShellButton_Click" ToolTip.Tip="Открыть ADB shell">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#394252"><TextBlock Text=">_" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Shell" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="ClipboardButton_Click" ToolTip.Tip="Отправить текст из буфера">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#148E9E"><TextBlock Text="▤" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Буфер" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="PowerButton_Click" ToolTip.Tip="Включить или выключить экран">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#D54B43"><TextBlock Text="⏻" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Питание" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="WirelessButton_Click" ToolTip.Tip="Wireless debugging">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#326BB5"><TextBlock Text="⌁" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Wi-Fi ADB" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="CompanionButton_Click" ToolTip.Tip="Сопряжение companion">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#6157A8"><TextBlock Text="◫" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Компаньон" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
              <Button Classes="tile" Click="RefreshButton_Click" ToolTip.Tip="Обновить устройства">
                <StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#596273"><TextBlock Text="↻" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Обновить" Margin="0,5,0,0" FontSize="10.5" HorizontalAlignment="Center"/></StackPanel>
              </Button>
            </UniformGrid>

            <Border x:Name="WirelessPanel" IsVisible="False" Margin="3,9,3,3" Padding="10"
                    CornerRadius="12" Background="{DynamicResource MutedSurface}">
              <StackPanel>
                <TextBlock Text="Wireless debugging" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
                <TextBox x:Name="WirelessEndpointText" Classes="compact" Margin="0,7,0,0" PlaceholderText="host:port" />
                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                  <TextBox x:Name="WirelessCodeText" Classes="compact" PlaceholderText="6 цифр" MaxLength="6" />
                  <Button Grid.Column="1" Classes="compact" Margin="6,0,0,0" Content="Сопрячь" Click="WirelessPairButton_Click" />
                </Grid>
                <Button Classes="compact" Margin="0,6,0,0" Content="Подключить" Click="WirelessConnectButton_Click" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="3,7,3,0">
          <TextBlock x:Name="PanelStatusText" Text="Готово" FontSize="10"
                     Foreground="{DynamicResource Secondary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel x:Name="DrawerBubblePanel" Grid.RowSpan="3" ZIndex="30"
                    Margin="4,48,4,38" Spacing="5" MaxHeight="190"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top" />
      </Grid>
    </Border>
  </Popup>

  <Popup x:Name="NotificationPopup" IsLightDismissEnabled="False" WindowManagerAddShadowHint="False">
    <Border x:Name="NotificationBubbleHost" Width="280" Margin="6" Background="Transparent">
      <StackPanel x:Name="ExternalBubblePanel" Spacing="5" MaxHeight="210" />
    </Border>
  </Popup>
  </Grid>
</Window>

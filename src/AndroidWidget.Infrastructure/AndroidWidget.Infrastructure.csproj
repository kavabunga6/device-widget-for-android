<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AndroidWidget.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AndroidWidget.Core\AndroidWidget.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\vendor\scrcpy-win64-v4.0.zip"
                      LogicalName="AndroidWidget.Infrastructure.Bundled.scrcpy-win64-v4.0.zip" />
    <EmbeddedResource Include="..\..\vendor\scrcpy-LICENSE.txt"
                      LogicalName="AndroidWidget.Infrastructure.Bundled.scrcpy-LICENSE.txt" />
    <EmbeddedResource Include="..\..\companion-android\app\build\outputs\apk\release\app-release.apk"
                      Condition="Exists('..\..\companion-android\app\build\outputs\apk\release\app-release.apk')"
                      LogicalName="AndroidWidget.Infrastructure.Bundled.AndroidWidget-Companion.apk" />
    <EmbeddedResource Include="..\..\companion-android\app\build\outputs\apk\debug\app-debug.apk"
                      Condition="!Exists('..\..\companion-android\app\build\outputs\apk\release\app-release.apk') And Exists('..\..\companion-android\app\build\outputs\apk\debug\app-debug.apk')"
                      LogicalName="AndroidWidget.Infrastructure.Bundled.AndroidWidget-Companion.apk" />
  </ItemGroup>
</Project>
